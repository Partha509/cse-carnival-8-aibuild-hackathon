# Copy this file to .env and fill in your values
# Never commit your actual .env file

# ---- AI Agent (server-only; never exposed to the browser) ----
# Provider: openai (default) | groq
LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
# Groq is OpenAI-compatible; set LLM_PROVIDER=groq to use it instead
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# IANA timezone used to resolve "today" / "tomorrow" for the campus
CAMPUS_TIMEZONE=Asia/Dhaka

# Backend / Database (examples — use whatever fits your stack)
DATABASE_URL=your_database_url_here
PORT=3000
